<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ujian Digital SD</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Nunito+Sans:wght@700;800&display=swap" rel="stylesheet">
  <link href="css/style.css" rel="stylesheet">
</head>
<body>
  <div id="barLoading" class="bar-loading"></div>
  <div id="loadingOverlay" class="loading-overlay">
    <div class="spinner-border text-primary" role="status"></div>
    <p class="mt-3 text-muted">Memuat aplikasi...</p>
  </div>


  <!-- ===== MOTION GRAFIS PENGANTAR (15 detik) ===== -->
  <section id="viewIntro" class="intro hidden" aria-label="Pengenalan aplikasi">
    <div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div>
    <div class="confetti" id="confetti"></div>
    <div class="sc s1" style="--d:0s;--dur:3.4s">
      <div class="intro-logo"><span class="ring r1"></span><span class="ring r2"></span><div class="logo-box logo-slot big"></div></div>
      <div class="intro-sch" id="introSekolah"></div>
      <h1 class="intro-title"><span style="--i:0">Ujian</span> <span style="--i:1">Digital</span> <span style="--i:2">SD</span></h1>
    </div>
    <div class="sc s2" style="--d:3.1s;--dur:3.4s">
      <h2>Ujian tanpa kertas,<br>tanpa ribet.</h2>
      <div class="cards3">
        <div class="mini c1"><span class="mi">A</span> Pilihan Ganda</div>
        <div class="mini c2"><span class="mi"><i class="bi bi-check2-square"></i></span> PG Kompleks</div>
        <div class="mini c3"><span class="mi"><i class="bi bi-check-lg"></i></span> Benar / Salah</div>
      </div>
      <p>Dikerjakan lewat laptop atau HP</p>
    </div>
    <div class="sc s3" style="--d:6.2s;--dur:3.4s">
      <div class="ringwrap">
        <svg viewBox="0 0 120 120" width="150" height="150"><circle cx="60" cy="60" r="54" class="rg-bg"/><circle cx="60" cy="60" r="54" class="rg-fg"/></svg>
        <div class="rg-txt"><i class="bi bi-alarm"></i><span>01:30:00</span></div>
        <div class="saved"><i class="bi bi-cloud-check-fill"></i> tersimpan</div>
      </div>
      <h2>Timer jelas, jawaban aman.</h2>
      <p>Tersimpan otomatis, walau sinyal putus-sambung</p>
    </div>
    <div class="sc s4" style="--d:9.3s;--dur:3.4s">
      <div class="bars"><i style="--h:42%;--k:0"></i><i style="--h:68%;--k:1"></i><i style="--h:55%;--k:2"></i><i style="--h:86%;--k:3"></i><i style="--h:100%;--k:4"></i><span class="mail"><i class="bi bi-envelope-paper-fill"></i></span></div>
      <h2>Nilai keluar sendiri.</h2>
      <p>Grafik rekap, PDF A4, dan email ke orang tua</p>
    </div>
    <div class="sc s5" style="--d:12.4s;--dur:2.6s">
      <div class="intro-logo sm"><span class="ring r1"></span><div class="logo-box logo-slot big"></div></div>
      <h2>Siap mulai ujian?</h2>
      <div class="go">Masuk sekarang <i class="bi bi-arrow-down"></i></div>
    </div>
    <button class="skip" onclick="akhiriIntro()">Lewati <i class="bi bi-chevron-right"></i></button>
    <div class="intro-prog"><i></i></div>
  </section>

  <!-- ===== TRANSISI LOGO (saat keluar portal) ===== -->
  <section id="viewTransisi" class="transisi hidden" aria-hidden="true">
    <div class="tr-logo"><span class="ring r1"></span><span class="ring r2"></span><div class="logo-box logo-slot big"></div></div>
    <div class="tr-teks" id="trTeks">Sampai jumpa!</div>
  </section>

  <!-- ===== LOGIN ===== -->
  <section id="viewLogin" class="login-wrap hidden">
    <div class="login-card">
      <div class="text-center mb-3">
        <div class="logo-box logo-slot" id="loginLogo"></div>
        <h2 class="mb-1">Ujian Digital SD</h2>
        <div class="text-muted small" id="loginSekolah">Silakan masuk</div>
      </div>
      <div id="loginError" class="alert-x mb-3 hidden"></div>
      <div class="mb-3">
        <label class="form-label" for="inUser">Username / NISN <span class="text-danger">*</span></label>
        <input id="inUser" class="form-control" autocomplete="username" inputmode="text" placeholder="Contoh: 0123984510">
      </div>
      <div class="mb-3">
        <label class="form-label" for="inPass">Kata Sandi <span class="text-danger">*</span></label>
        <div class="position-relative">
          <input id="inPass" type="password" class="form-control pe-5" autocomplete="current-password">
          <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted" onclick="togglePass()" aria-label="Tampilkan sandi"><i class="bi bi-eye" id="eyeIc"></i></button>
        </div>
      </div>
      <button id="btnLogin" class="btn btn-primary w-100 py-2 fs-5" onclick="doLogin()">Masuk Ujian <i class="bi bi-arrow-right"></i></button>
      <div class="mt-3 p-3 small text-muted" style="background:var(--primary-50);border-radius:12px">
        <i class="bi bi-info-circle"></i> Akun dibuat oleh pihak sekolah. Hubungi wali kelas atau pengawas jika mengalami kendala login.
      </div>
      <div class="text-center mt-3"><a href="#" class="small text-muted" onclick="toggleTheme();return false"><i class="bi bi-moon-stars"></i> Ganti tema</a></div>
    </div>
  </section>

  <!-- ===== STAF (ADMIN / GURU) ===== -->
  <section id="viewStaff" class="hidden">
    <div id="sbOverlay" class="sb-overlay" onclick="closeSidebar()"></div>
    <nav id="sidebar" class="sidebar">
      <div class="sidebar-head">
        <div class="logo-box logo-slot" id="sbLogo"></div>
        <div><b id="sbSekolah">Ujian Digital SD</b><small id="sbPeran">Portal</small></div>
      </div>
      <ul class="sidebar-nav" id="sbNav"></ul>
      <div class="sidebar-foot">
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" id="darkToggle" onchange="toggleTheme()">
          <label class="form-check-label" for="darkToggle"><i class="bi bi-moon-stars"></i> Mode Gelap</label>
        </div>
        <a class="d-flex align-items-center gap-2 text-decoration-none" style="color:var(--sidebar-text);cursor:pointer" onclick="doLogout()"><i class="bi bi-box-arrow-left"></i> Keluar Portal</a>
      </div>
    </nav>
    <main class="main">
      <div class="topbar">
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-soft btn-sm d-md-none" onclick="toggleSidebar()" aria-label="Menu"><i class="bi bi-list fs-5"></i></button>
          <span class="nunito fw-bold" id="topTitle">Dashboard</span>
        </div>
        <div class="text-end small"><b id="topNama"></b><br><span class="text-muted" id="topSub"></span></div>
      </div>
      <div class="page" id="pageContent"></div>
    </main>
  </section>

  <!-- ===== SISWA ===== -->
  <section id="viewSiswa" class="hidden">
    <div class="s-head">
      <div class="d-flex align-items-center gap-2">
        <div class="logo-box logo-slot" id="sLogo" style="width:42px;height:42px;margin:0;font-size:1.1rem"></div>
        <div><b class="nunito" id="sSekolah"></b><div class="small text-primary fw-semibold">Ujian Digital SD</div></div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <div class="small text-end d-none d-sm-block"><b id="sNama"></b><br><span class="text-muted" id="sSub"></span></div>
        <button class="btn btn-soft btn-sm" id="btnKeluarS" onclick="doLogout()"><i class="bi bi-box-arrow-right"></i> Keluar</button>
      </div>
    </div>
    <div id="siswaContent"></div>
  </section>

  <!-- ===== MODAL UMUM ===== -->
  <div class="modal fade" id="mdl" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" id="mdlDialog">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="mdlTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
        <div class="modal-body" id="mdlBody"></div>
        <div class="modal-footer" id="mdlFoot"></div>
      </div>
    </div>
  </div>
  <!-- Modal pratinjau (gambar / PDF) — tidak membuka tab baru -->
  <div class="modal fade" id="mdlPrev" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="prevTitle">Pratinjau</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body text-center" id="prevBody"></div>
        <div class="modal-footer"><button class="btn btn-soft" data-bs-dismiss="modal"><i class="bi bi-x-lg"></i> Tutup</button><a id="prevDl" class="btn btn-primary" href="#" target="_blank" rel="noopener"><i class="bi bi-download"></i> Unduh</a></div>
      </div>
    </div>
  </div>
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:2000">
    <div id="appToast" class="toast" role="alert"><div class="toast-header"><strong class="me-auto" id="toastTitle"></strong><button type="button" class="btn-close" data-bs-dismiss="toast"></button></div><div class="toast-body" id="toastBody"></div></div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js"></script>
  <script src="js/config.js"></script>
  <script src="js/api.js"></script>
  <script src="js/core.js"></script>
  <script src="js/soal.js"></script>
  <script src="js/siswa.js"></script>
</body>
</html>
